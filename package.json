{
  "name": "app-sorteos",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @sorteos/api",
    "build:api": "npm run build --workspace @sorteos/api && npm run build --workspace @sorteos/api-client",
    "typecheck:api": "npm run typecheck --workspace @sorteos/api && npm run typecheck --workspace @sorteos/api-client",
    "test:config": "node --experimental-strip-types --test apps/api/test/config.test.mjs",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps/api packages/api-client",
    "test": "npm run test --workspace @sorteos/api",
    "test:integration": "npm run test:integration --workspace @sorteos/api",
    "test:catalog": "npm run test:catalog --workspace @sorteos/api",
    "db:migrate:local": "npm run db:migrate:local --workspace @sorteos/api",
    "db:seed:demo": "npm run db:seed:demo --workspace @sorteos/api",
    "admin:provision:local": "npm run admin:provision:local --workspace @sorteos/api",
    "generate:api": "npm run openapi --workspace @sorteos/api && npm run generate --workspace @sorteos/api-client"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/node": "^22.19.21",
    "eslint": "^9.39.3",
    "supabase": "2.122.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
