NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
LOG_LEVEL=info
RATE_LIMIT=120
RATE_TTL_MS=60000
# Opcional en desarrollo. Sin DB, ready devuelve 503 DATABASE_NOT_CONFIGURED.
DATABASE_URL=
# TLS con verificacion de certificado por defecto. Desactivar solo en PostgreSQL local.
DATABASE_SSL=true
# Certificado CA PEM opcional, con saltos de linea escapados como \n.
DATABASE_CA=
# Comandos locales exclusivamente; nunca habilitar en staging/production.
SEED_DEMO=false
# Proyecto propio con claves de firma asimétricas ES256/RS256. Sin valor: admin falla cerrado.
SUPABASE_URL=
# Clave publicable del mismo proyecto, no service_role ni sb_secret_. Solo servidor.
SUPABASE_PUBLISHABLE_KEY=
# Bucket público exclusivo de imágenes de premios, nunca el de comprobantes.
PUBLIC_RAFFLE_BUCKET=raffle-media
# Bootstrap manual local sobre DB migrada SIN seed. UUID real del usuario Supabase propio.
PROVISION_LOCAL_ADMIN=false
LOCAL_ADMIN_USER_ID=
LOCAL_ADMIN_ROLE=OWNER
